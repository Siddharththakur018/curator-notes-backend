# Server
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://user:password@localhost:5432/curator_notes

# Firebase Admin (use env vars OR src/config/serviceAccountKey.json, not both)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Google Gemini
GEMINI_API_KEY=

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
